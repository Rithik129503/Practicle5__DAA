#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int knapsack(int W, vector<int>& weight, vector<int>& value, int n) {
    vector<vector<int>> dp(n + 1, vector<int>(W + 1, 0));

    for (int i = 1; i <= n; i++) {
        for (int w = 0; w <= W; w++) {
            dp[i][w] = dp[i - 1][w];

            if (weight[i - 1] <= w) {
                dp[i][w] = max(dp[i][w],
                    value[i - 1] + dp[i - 1][w - weight[i - 1]]);
            }
        }
    }

    return dp[n][W];
}

int main() {
    vector<int> weight = {2, 1, 3, 2};
    vector<int> value = {12, 10, 20, 15};

    int W = 5;
    int n = weight.size();

    cout << knapsack(W, weight, value, n);

    return 0;
}
